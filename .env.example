# Anthropic Claude API key — used in Phase 0 (niche gen), Phase 1 (keywords), Phase 3 (scoring), Phase 5 (analysis)
ANTHROPIC_API_KEY=

# Meta Ad Library long-lived access token — used in Phase 2 (scraper) and Phase 4 (Lebanon check)
# Generate via: https://developers.facebook.com/tools/explorer/ then exchange for a 60-day token
META_ACCESS_TOKEN=

# SerpApi key — used in Phase 0.5 (Google Trends validation)
# Free tier: 100 searches/month. Sign up at https://serpapi.com
SERPAPI_KEY=

# Notion integration token — used in Phase 0, Phase 1 (dedup), and Phase 6 (writer)
NOTION_API_KEY=

# Notion database IDs — create three databases in Notion, then paste each database ID below
NOTION_NICHES_DB_ID=      # Niches table (Flow A)
NOTION_KEYWORDS_DB_ID=    # Keywords table (Flow A)
NOTION_DATABASE_ID=       # Products table (Flow B — weekly output)

{
  "name": "lebanon-product-research-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly automated agent that scrapes Meta Ad Library, scores products for private labeling in Lebanon, and writes reports to Notion.",
  "scripts": {
    "phase0": "ts-node src/phases/phase0-niches.ts",
    "phase0-5": "ts-node src/phases/phase0-5-trends.ts",
    "phase1": "ts-node src/phases/phase1-keywords.ts",
    "phase2": "ts-node src/phases/phase2-scraper.ts",
    "phase3": "ts-node src/phases/phase3-filter.ts",
    "phase3-1": "ts-node src/phases/phase3-1-heuristic.ts",
    "phase4": "ts-node src/phases/phase4-competition.ts",
    "phase5": "ts-node src/phases/phase5-suppliers.ts",
    "phase6": "ts-node src/phases/phase6-analysis.ts",
    "phase6-1": "ts-node src/phases/phase6-1-template.ts",
    "phase7": "ts-node src/phases/phase7-notion.ts",
    "setup": "ts-node src/utils/setup-notion-db.ts",
    "build": "tsc",
    "lint": "echo \"lint placeholder — add eslint later\" && exit 0",
    "pipeline": "ts-node src/pipeline.ts",
    "scheduler": "ts-node src/scheduler.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@notionhq/client": "^2.2.15",
    "axios": "^1.7.7",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
